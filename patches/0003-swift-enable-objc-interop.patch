+/* Minimal TargetConditionals.h for non-Apple builds (GNUstep / libobjc2).
+ *
+ * Swift's availability and Objective-C image-name code include this header and
+ * branch on the TARGET_OS_* / TARGET_CPU_* macros. On Darwin the SDK provides
+ * the real one; here every Apple-only platform is 0, so those code paths fall
+ * to their "not Apple" side. The mach-o include in
+ * ObjCRuntimeGetImageNameFromClass.mm already self-guards with __has_include.
+ */
+#ifndef __TARGETCONDITIONALS__
+#define __TARGETCONDITIONALS__
+
+#define TARGET_OS_MAC        0
+#define TARGET_OS_OSX        0
+#define TARGET_OS_IPHONE     0
+#define TARGET_OS_IOS        0
+#define TARGET_OS_TV         0
+#define TARGET_OS_WATCH      0
+#define TARGET_OS_SIMULATOR  0
+#define TARGET_OS_EMBEDDED   0
+#define TARGET_OS_LINUX      1
+#define TARGET_OS_UNIX       1
+#define TARGET_OS_WIN32      0
+
+#define TARGET_CPU_X86_64    1
+#define TARGET_CPU_ARM64     0
+#define TARGET_CPU_PPC64     0
+
+#endif /* __TARGETCONDITIONALS__ */
