+  auto *abiVersion =
+      llvm::ConstantInt::get(IGM.IntPtrTy, SWIFT_GNUSTEP_CLASS_ABI_VERSION);
+
+  llvm::Constant *fields[] = {
+    nullPtr,       // isa: resolved by libobjc2
+    nullPtr,       // super_class: resolved by libobjc2
+    data.Name,     // name (shared with the class)
+    zero,          // version
+    metaFlag,      // info
+    zero,          // instance_size
+    nullOpaque,    // ivars
+    data.ClassMethods, // methods
+    nullOpaque,    // dtable
+    nullPtr,       // subclass_list
+    nullOpaque,    // cxx_construct
+    nullOpaque,    // cxx_destruct
+    nullPtr,       // sibling_class
+    nullOpaque,    // protocols
+    nullOpaque,    // extra_data
+    abiVersion,    // abi_version
+    nullOpaque     // properties
