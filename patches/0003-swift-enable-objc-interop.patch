+/// Which layout does a Swift class metadata object use?
+///
+///  0 - the compact Swift layout: `kind`, `superclass`, then the Swift fields.
+///  1 - an Objective-C class object with Apple's `class_t` header
+///      (`isa`, `superclass`, `cache[2]`, `data`), as on Darwin.
+///  2 - an Objective-C class object with GNUstep's `struct objc_class` header
+///      (`isa`, `super_class`, `name`, `version`, `info`, ...), as required by
+///      libobjc2 for a runtime that must see Swift classes as real classes.
+///
+/// Interop being enabled does *not* imply layout 1: only Apple's ObjC runtime
+/// shares its class layout with Swift.  A GNUstep-vendor runtime uses layout 2,
+/// and a runtime whose classes Swift never exposes uses layout 0.
+///
+/// The layout is deliberately independent of SWIFT_OBJC_INTEROP so that interop
+/// *semantics* (messaging, `id`, bridging) can be kept while changing the class
+/// metadata ABI - and so that the very large set of places that assume
+/// "interop implies Apple's class layout" can be migrated one at a time.
+///
+/// Darwin keeps the historical behaviour (interop implies Apple's layout).
+/// Everywhere else the default is layout 2: this fork targets a GNUstep-vendor
+/// Objective-C runtime, and layout 2 is the ABI that makes Swift classes real
+/// GNUstep class objects (SWIFT-GNUSTEP-CLASS-ABI.md stages S1-S5, all gated;
+/// SWIFT-PORT-HANDOFF.md has the results).  The compiler is a host tool and
+/// runs on the bootstrap toolchain's compact-layout runtime, which is
+/// independent of this value: the layout here is the one its *output* uses.
+/// Builds that want the previous default pass `-DSWIFT_OBJC_CLASS_LAYOUT=0`
+/// (AGORA_SWIFT_CLASS_LAYOUT=0 through swift-toolchain/scripts/native-env.sh).
+#ifndef SWIFT_OBJC_CLASS_LAYOUT
+#if defined(__APPLE__)
+#define SWIFT_OBJC_CLASS_LAYOUT SWIFT_OBJC_INTEROP
+#else
+#define SWIFT_OBJC_CLASS_LAYOUT 2
+#endif
+#endif
+
+/// Does a Swift class metadata object have to be a real Objective-C class
+/// object (layout 1 or 2), i.e. does the Objective-C runtime get to see Swift
+/// classes?  Distinct from SWIFT_OBJC_INTEROP, which is about *semantics*:
+/// messaging Agora objects, `id`, bridging, and so on - all of which keep
+/// working with the compact layout, in one direction.
+#define SWIFT_OBJC_CLASS_OBJECT_LAYOUT (SWIFT_OBJC_CLASS_LAYOUT != 0)
+
+/// How is a Swift `Error` box represented?
+///
+///  1 - as an NSError-compatible object (the coccinelle `ErrorObject.mm`
+///      implementation).  This requires a class-object layout: the box is
+///      handed to the Objective-C runtime as an NSError, and it is a Swift
+///      class object rather than a plain heap allocation.
+///  0 - as a plain Swift heap object (`ErrorObjectNative.cpp`), which is what
+///      the compact class layout requires.
+#define SWIFT_ERROR_IS_NSError \
+  (SWIFT_OBJC_INTEROP && SWIFT_OBJC_CLASS_OBJECT_LAYOUT)
