+#ifdef TYPE_DEPENDENT_DISPATCH
+			// AGORA: in TDD mode `installMethodInDtable' also stores every
+			// method under the *untyped* selector of its name, and that is the
+			// slot every Swift send uses (Swift's selector records are
+			// untyped).  Rebuilding the table for a new superclass must keep
+			// that property: without it the untyped slot of an overridden name
+			// is filled from the new parent, so a Swift send would reach the
+			// superclass's implementation.  That is exactly how the Swift
+			// runtime's `__SwiftNativeNSError -domain' (typed `@16@0:8') lost
+			// to NSError's `-domain' (typed `@"NSString"16@0:8') after
+			// class_setSuperclass() reparented the error box.
+			uint32_t untypedIdx = get_untyped_idx(m->selector);
+			if (SparseArrayLookup(temporaryDtable, untypedIdx) == NULL)
+			{
+				SparseArrayInsert(temporaryDtable, untypedIdx, m);
+			}
+			SparseArrayInsert(dtable, untypedIdx, m);
+#endif
 		}
