diff --git a/Sources/FoundationEssentials/Bundle+Stub.swift b/Sources/FoundationEssentials/Bundle+Stub.swift
index b64159f..ab4dbbf 100644
--- a/Sources/FoundationEssentials/Bundle+Stub.swift
+++ b/Sources/FoundationEssentials/Bundle+Stub.swift
@@ -10,10 +10,19 @@
 //
 //===----------------------------------------------------------------------===//
 
+// This is the stand-in for a *bundle* on platforms whose Foundation has no
+// Objective-C Foundation, and FoundationInternationalization is its only user.
+//
+// It is NOT named `Bundle`: on a platform that does have one, `NSBundle` imports
+// into Swift as `Bundle`, and two declarations of that name make every
+// `Bundle`-naming file ambiguous as soon as `@testable import FoundationEssentials`
+// is in scope (the ported test suites do exactly that).  Agora is such a platform:
+// its Clang Foundation supplies `Bundle`, this stub supplies the localizations
+// FoundationInternationalization needs, and the two live under different names.
 #if !FOUNDATION_FRAMEWORK
 
-package struct Bundle: Hashable, Equatable, Sendable {
-    public static let main: Bundle = Bundle()
+package struct FoundationBundle: Hashable, Equatable, Sendable {
+    public static let main: FoundationBundle = FoundationBundle()
 
     public var localizations: [String] { return [] }
 
